<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="DeskBackground" Color="#FAFAFC" />
    <SolidColorBrush x:Key="DeskSidebar" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DeskSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DeskText" Color="#282633" />
    <SolidColorBrush x:Key="DeskMuted" Color="#797487" />
    <SolidColorBrush x:Key="DeskBorder" Color="#E5E4EB" />
    <SolidColorBrush x:Key="DeskAccent" Color="#7963BF" />
    <SolidColorBrush x:Key="DeskAccentSoft" Color="#247963BF" />
    <SolidColorBrush x:Key="DeskOnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DeskSuccess" Color="#9ACDA9" />
    <StaticResource x:Key="ButtonBackground" ResourceKey="DeskSurface" />
    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="DeskAccentSoft" />
    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="DeskAccentSoft" />
    <StaticResource x:Key="ButtonForeground" ResourceKey="DeskText" />
    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="DeskText" />
    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="DeskText" />
    <StaticResource x:Key="ButtonBorderBrush" ResourceKey="DeskBorder" />
    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="DeskAccent" />
    <StaticResource x:Key="AccentButtonBackground" ResourceKey="DeskAccent" />
    <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="DeskAccent" />
    <StaticResource x:Key="AccentButtonForeground" ResourceKey="DeskOnAccent" />
    <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="DeskOnAccent" />
    <StaticResource x:Key="SubtleButtonBackgroundPointerOver" ResourceKey="DeskAccentSoft" />
    <StaticResource x:Key="SubtleButtonForegroundPointerOver" ResourceKey="DeskText" />
    <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="DeskAccent" />
    <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="DeskAccent" />
    <StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="DeskOnAccent" />
    <StaticResource x:Key="SliderTrackValueFill" ResourceKey="DeskAccent" />
    <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="DeskAccent" />
    <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="DeskAccent" />
    <StaticResource x:Key="SliderThumbBackground" ResourceKey="DeskAccent" />
    <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="DeskAccent" />
    <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="DeskAccent" />
    <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="DeskAccentSoft" />
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
        <Setter Property="Foreground" Value="{StaticResource DeskText}" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="DeskButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{StaticResource DeskSurface}" />
        <Setter Property="Foreground" Value="{StaticResource DeskText}" />
        <Setter Property="BorderBrush" Value="{StaticResource DeskBorder}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="DeskPrimary" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Background" Value="{StaticResource DeskAccent}" />
        <Setter Property="Foreground" Value="{StaticResource DeskOnAccent}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="DeskQuiet" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource DeskMuted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="DeskNav" TargetType="Button" BasedOn="{StaticResource DeskQuiet}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style x:Key="DeskSwatch" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Swatch.Opacity" Value="0.8" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Swatch.Opacity" Value="0.6" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Swatch.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Swatch" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource DeskSurface}" />
        <Setter Property="Foreground" Value="{StaticResource DeskText}" />
        <Setter Property="BorderBrush" Value="{StaticResource DeskBorder}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource DeskSurface}" />
        <Setter Property="Foreground" Value="{StaticResource DeskText}" />
        <Setter Property="BorderBrush" Value="{StaticResource DeskBorder}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style TargetType="ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Width" Value="46" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
</ResourceDictionary>
