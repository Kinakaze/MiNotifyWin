<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MiPushDesk.Core\MiPushDesk.Core.csproj" />
    <Compile Include="..\..\src\MiPushDesk\Services\NativeFileDialog.cs;..\..\src\MiPushDesk\Services\ImageService.cs;..\..\src\MiPushDesk\Services\NotificationService.cs" Link="Services\%(Filename)%(Extension)" />
    <Content Include="..\..\src\MiPushDesk\Assets\preview.png" Link="Assets\preview.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\MiPushDesk\Assets\AppIcons\delta.zip" Link="Assets\AppIcons\delta.zip" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
